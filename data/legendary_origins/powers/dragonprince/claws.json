{
  "type": "origins:multiple",
  "name": "Dragon Claws",
  "description": "Your dragon claws are sharp and powerful, perfect to make your enemies bleed. You can also climb any surface, and if not needed, retract them at anytime.",
  "base_damage": {
    "type": "origins:attribute",
    "modifier": {
      "id": "legendary_origins:dragonprince_base_damage_increase",
      "attribute": "minecraft:generic.attack_damage",
      "amount": 6,
      "operation": "add_value"
    }
  },
  "bleeding": {
    "type": "origins:action_on_hit",
    "bientity_action": {
      "type": "target_action",
      "action": {
        "type": "origins:apply_effect",
        "effect": {
          "id": "minecraft:wither",
          "duration": 80,
          "amplifier": 1,
          "show_icon": false,
          "show_particles": false,
          "is_ambient": true
        }
      }
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.secondary_active",
      "continuous": false
    }
  },
  "toggle_notifier": {
    "type": "origins:active_self",
    "key": {
      "key": "key.origins.secondary_active",
      "continuous": false
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power_active",
        "power": "*:*_toggle"
      },
      "if_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\":\"Claws retracted\",\"color\":\"red\"}"
      },
      "else_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\":\"Claws extended\",\"color\":\"green\"}"
      }
    }
  },
  "climbing": {
    "type": "origins:climbing",
    "hold_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:block_collision",
              "offset_x": 0.01,
              "offset_z": 0.01,
              "offset_y": 0
            },
            {
              "type": "origins:block_collision",
              "offset_x": -0.01,
              "offset_z": -0.01,
              "offset_y": 0
            }
          ]
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:collided_horizontally"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        }
      ]
    }
  }
}