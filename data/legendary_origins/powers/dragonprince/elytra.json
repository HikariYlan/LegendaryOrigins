{
  "type": "origins:multiple",
  "name": "Wings",
  "description": "Being a dragon prince offers you the possibility to fly. But be careful! Water makes your wings heavy, so you will automatically retract them under the rain or in the water. You also can retract them manually.",
  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  },
  "toggle_notifier": {
    "type": "origins:active_self",
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power_active",
        "power": "*:*_toggle"
      },
      "if_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\":\"Wings extended\",\"color\":\"green\"}"
      },
      "else_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\":\"Wings retracted\",\"color\":\"red\"}"
      }
    }
  },
  "elytra": {
    "type": "origins:elytra_flight",
    "render_elytra": true,
    "texture_location": "legendary_origins_resourcepack:textures/entity/elytra.png",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:in_rain",
          "inverted": true
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": ">",
          "compare_to": 0.0,
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle",
          "inverted": true
        }
      ]
    }
  }
}